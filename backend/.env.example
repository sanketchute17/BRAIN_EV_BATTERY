# BRAIN EV Battery Analytics — Cloud Production Environment Configuration
# Copy this file to .env for local development or set environment variables in your cloud hosting provider (e.g. Render / Railway / AWS).

# Application Environment (development / production / staging)
ENVIRONMENT=development

# Server Port (automatically provided by cloud hosts like Render)
PORT=8000

# Database Connection URL
# Local Development (SQLite):
DATABASE_URL=sqlite:///./brain_ev.db

# Production (Supabase PostgreSQL / Cloud DB):
# DATABASE_URL=postgresql://postgres.your_user_id:your_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# JWT Secret Key for Authentication
# Place a secure random 64-character secret key here for production
JWT_SECRET=brain_ev_super_secret_jwt_key_2026_academic_research

# CORS Allowed Origins (comma-separated list of origins)
# Explicit domain names required in production — wildcard (*) is forbidden in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Telemetry Engine Settings
TELEMETRY_RATE_HZ=5
HISTORY_BUFFER_SIZE=300
